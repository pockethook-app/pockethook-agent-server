# Required: Auth token for FlowMate app
AUTH_TOKEN=your-secret-token

# Required: API key for your LLM provider
LLM_API_KEY=your-api-key

# Agent display name (how it introduces itself)
# AGENT_NAME=FlowMate Assistant

# LLM provider: anthropic, openai, openai-codex, github-copilot, google, mistral, groq, xai, openrouter, ollama
LLM_PROVIDER=anthropic

# Model ID (must match the provider)
LLM_MODEL=claude-sonnet-4-20250514

# Custom base URL for the LLM API (required for ollama, optional for others)
# LLM_BASE_URL=http://localhost:11434/v1

# OAuth tokens for openai-codex / github-copilot (set automatically by: bun run setup)
# OAUTH_REFRESH_TOKEN=...
# OAUTH_TOKEN_EXPIRES=...

# Optional: Server port (default 3000)
# PORT=3000

# Optional: Max conversation history per session (default 50)
# MAX_HISTORY=50

# Optional: Session TTL in minutes (default 60)
# SESSION_TTL_MINUTES=60

# Working directory for agent tools (default: workspace/)
# WORKING_DIR=/home/user

# Fetch message trigger (must match FlowMate app setting, default: fetchPendingTasks)
# FETCH_MESSAGE=fetchPendingTasks

# Web dashboard (default: enabled, set to false to disable)
# DASHBOARD=false

# Web search: serper (API key) or searxng (self-hosted)
# SEARCH_PROVIDER=serper
# SEARCH_API_KEY=your-serper-api-key
# SEARCH_URL=http://localhost:8080

# User location (auto-detected from IP if not set)
# Used for location-aware searches and regional context.
# LOCALE_COUNTRY=Spain
# LOCALE_CITY=Madrid
# LOCALE_TIMEZONE=Europe/Madrid

# HTTPS tunnel port for Tailscale (default: auto-detect free port)
# HTTPS_PORT=8443

# Log level: debug, info, warn, error (default: info)
# In production (NODE_ENV=production), outputs JSON lines.
# LOG_LEVEL=info

# Rate limiting: max requests per window (default: 30 req/60s)
# RATE_LIMIT_MAX=30
# RATE_LIMIT_WINDOW_MS=60000

# Tool permissions are configured in permissions.json
# Run: bun run permissions
