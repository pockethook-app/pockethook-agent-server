# Required: Auth token for PocketHook app
AUTH_TOKEN=your-secret-token

# Required: API key for your LLM provider
LLM_API_KEY=your-api-key

# Agent display name (how it introduces itself)
# AGENT_NAME=PocketHook Assistant

# LLM provider: anthropic, openai, openai-codex, github-copilot, google, mistral, groq, xai, openrouter, ollama, lm-studio
LLM_PROVIDER=anthropic

# Model ID (must match the provider)
LLM_MODEL=claude-sonnet-4-20250514

# Custom base URL for the LLM API (required for ollama/lm-studio, optional for others)
# LLM_BASE_URL=http://localhost:11434/v1
# LLM_BASE_URL=http://localhost:1234/v1

# OAuth tokens for openai-codex / github-copilot (set automatically by: bun run setup)
# OAUTH_REFRESH_TOKEN=...
# OAUTH_TOKEN_EXPIRES=...

# Optional: Server port (default 3000)
# PORT=3000

# Optional: Max conversation history per session (default 50)
# MAX_HISTORY=50

# Optional: Session TTL in minutes (default 60)
# SESSION_TTL_MINUTES=60

# Working directory for agent tools (default: workspace/)
# WORKING_DIR=/home/user

# Fetch message trigger (must match PocketHook app setting, default: fetchPendingTasks)
# FETCH_MESSAGE=fetchPendingTasks

# Web dashboard (default: enabled, set to false to disable)
# DASHBOARD=false

# Web search: serper (API key) or searxng (self-hosted)
# SEARCH_PROVIDER=serper
# SEARCH_API_KEY=your-serper-api-key
# SEARCH_URL=http://localhost:8080

# User location (auto-detected from IP if not set)
# Used for location-aware searches and regional context.
# LOCALE_COUNTRY=Spain
# LOCALE_CITY=Madrid
# LOCALE_TIMEZONE=Europe/Madrid

# HTTPS tunnel port for Tailscale (default: auto-detect free port)
# HTTPS_PORT=8443

# Log level: debug, info, warn, error (default: info)
# In production (NODE_ENV=production), outputs JSON lines.
# LOG_LEVEL=info

# Rate limiting: max requests per window (default: 30 req/60s)
# RATE_LIMIT_MAX=30
# RATE_LIMIT_WINDOW_MS=60000

# Semantic memory: vector search + knowledge graph
# VECTOR_MEMORY=true
# EMBEDDING_PROVIDER=ollama
# EMBEDDING_MODEL=nomic-embed-text
# EMBEDDING_URL=http://localhost:11434
# EMBEDDING_API_KEY=your-openai-key
#
# Providers:
#   ollama     → EMBEDDING_URL=http://localhost:11434 (default), model: nomic-embed-text
#   lm-studio  → EMBEDDING_URL=http://localhost:1234, model: nomic-embed-text-v1.5
#   openai     → EMBEDDING_URL=https://api.openai.com, model: text-embedding-3-small (needs EMBEDDING_API_KEY)

# Safari extension (optional — configure with: bun run safari:config)
# Permission level: confirm (default: clicks with external effects ask first),
# autonomous (clicks run without asking; payments/deletions/account changes still ask),
# readonly (navigate, inspect and capture only)
# SAFARI_PERMISSION_LEVEL=confirm
# Public base URL for serving page captures (default: local only)
# SAFARI_CAPTURES_BASE_URL=https://your-host.example:8443

# Agent personality is configured in personality.md
# Run: bun run personality
# Or edit personality.md directly (hot-reloaded on next request)

# Tool permissions are configured in permissions.json
# Run: bun run permissions
