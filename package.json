{
  "name": "pockethook-agent-server",
  "version": "0.7.0",
  "description": "PocketHook agent server with LLM integration via pi-ai",
  "type": "module",
  "scripts": {
    "dev": "bun run --watch src/index.ts",
    "start": "bun run src/index.ts",
    "help": "bun run src/help.ts",
    "setup": "bun run src/setup.ts",
    "config": "bun run src/show-config.ts",
    "switch": "bun run src/setup.ts --switch",
    "personality": "bun run src/setup.ts --personality",
    "permissions": "bun run src/setup.ts --permissions",
    "memory": "bun run src/setup.ts --memory",
    "refresh": "bun run src/setup.ts --refresh",
    "service": "bun run src/service.ts",
    "safari:config": "bun run src/setup.ts --safari",
    "safari:code": "bun run src/safari-pair.ts code",
    "safari:status": "bun run src/safari-pair.ts status",
    "tunnel": "bun run src/tunnel.ts",
    "dev:tunnel": "bun run src/dev-tunnel.ts",
    "logs": "bun run src/logs.ts",
    "test": "bun test",
    "safari:install": "bun run src/safari-install.ts",
    "apple-bridge:install": "bun run src/apple-bridge-install.ts",
    "apple-bridge:code": "bun run src/apple-bridge-pair.ts",
    "apple-bridge:status": "bun run src/apple-bridge-status.ts"
  },
  "dependencies": {
    "@clack/prompts": "^1.1.0",
    "@earendil-works/pi-agent-core": "0.85.0",
    "@earendil-works/pi-ai": "0.85.0",
    "@sinclair/typebox": "^0.34.48",
    "open": "^11.0.0",
    "pdf-parse": "1.1.1",
    "picocolors": "^1.1.1",
    "pockethook-sdk": "0.1.3"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/pdf-parse": "^1.1.5",
    "typescript": "^5"
  },
  "overrides": {
    "@earendil-works/pi-ai": "0.85.0"
  }
}
