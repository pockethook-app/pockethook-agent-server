{
  "tools": [
    "shell",
    "read",
    "write",
    "ls",
    "create_project",
    "list_projects",
    "delete_project",
    "create_once_job",
    "create_cron_job",
    "list_jobs",
    "delete_job",
    "web_search",
    "web_fetch",
    "start_server",
    "stop_server",
    "list_servers",
    "search_memory",
    "remember_fact",
    "query_facts",
    "load_skill",
    "update_memory_status",
    "complete_project",
    "create_custom_tool",
    "create_user_skill",
    "set_reasoning"
  ],
  "shell": {
    "blockedCommands": ["shutdown", "reboot", "halt", "mkfs", "dd", "passwd", "chown", "chmod"],
    "blockedPatterns": [
      "sudo\\s+",
      "rm\\s+-rf\\s+/(?!\\w)",
      ">\\s*/etc/",
      "curl.*\\|.*sh",
      "wget.*\\|.*sh"
    ]
  },
  "filesystem": {
    "blockedPaths": [
      ".env",
      ".git"
    ],
    "blockedPatterns": [
      "*.key",
      "*.pem",
      "*.secret",
      "*.credentials",
      "id_rsa*"
    ]
  },
  "enforceWorkingDir": true
}
