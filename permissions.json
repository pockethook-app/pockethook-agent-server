{
  "tools": [
    "shell",
    "read",
    "write",
    "ls",
    "create_job",
    "list_jobs",
    "delete_job",
    "web_search",
    "web_fetch",
    "start_server",
    "stop_server",
    "list_servers"
  ],
  "shell": {
    "blockedCommands": ["shutdown", "reboot", "halt", "mkfs", "dd", "passwd", "chown", "chmod"],
    "blockedPatterns": [
      "sudo\\s+",
      "rm\\s+-rf\\s+/(?!\\w)",
      ">\\s*/etc/",
      "curl.*\\|.*sh",
      "wget.*\\|.*sh"
    ]
  },
  "filesystem": {
    "blockedPaths": [
      ".env",
      ".git"
    ],
    "blockedPatterns": [
      "*.key",
      "*.pem",
      "*.secret",
      "*.credentials",
      "id_rsa*"
    ]
  },
  "enforceWorkingDir": true
}
